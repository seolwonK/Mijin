                  "    if (err) failures.push(p.method + ' ' + p.path + ' → 요청 실패');",
                  "    else if (res.code === 401) failures.push(p.method + ' ' + p.path + ' → 401 (공개여야 한다)');",
                  "    if (++done === probes.length) {",
                  "      pm.test('[6번] 공개 엔드포인트 ' + probes.length + '개가 401 로 잠기지 않았다', function () {",
                  "        pm.expect(failures, failures.join(' | ')).to.have.lengthOf(0);",
                  "      });",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            }
