didates\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/requests/[id]/unassign\",\"method\":\"POST\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/requests/[id]/voice\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/rotation\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/settings\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/settings\",\"method\":\"PUT\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/settlements\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians\",\"method\":\"POST\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]\",\"method\":\"PATCH\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]/approve\",\"method\":\"POST\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]/contract\",\"method\":\"GET\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]/contract\",\"method\":\"PUT\",\"role\":\"ADMIN\"},{\"path\":\"/api/admin/technicians/[id]/reject\",\"method\":\"POST\",\"role\":\"ADMIN\"},{\"path\":\"/api/tech/commissions\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/contract\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/contract\",\"method\":\"PUT\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/eggs\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/jobs\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/jobs/[id]\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/jobs/[id]/accept\",\"method\":\"POST\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/jobs/[id]/reject\",\"method\":\"POST\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/jobs/[id]/status\",\"method\":\"POST\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/referrals\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/reviews\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/tech/stats\",\"method\":\"GET\",\"role\":\"TECHNICIAN\"},{\"path\":\"/api/partner/commissions\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/eggs\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/jobs\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/jobs/[id]\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/jobs/[id]/accept\",\"method\":\"POST\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/jobs/[id]/reject\",\"method\":\"POST\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/jobs/[id]/status\",\"method\":\"POST\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/profile\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/profile\",\"method\":\"PATCH\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/referrals\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/reviews\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/partner/stats\",\"method\":\"GET\",\"role\":\"PROVIDER\"},{\"path\":\"/api/requests/[id]/photos/[photoId]\",\"method\":\"GET\",\"role\":\"ADMIN\"}]",
      "type": "string",
      "description": "tests/helpers/routes.ts 의 가드 대상 목록을 그대로 옮긴 것. 라우트가 늘면 여기도 갱신한다(E2E 의 matrix-completeness 가 원본을 지킨다)."
    }
  ],
  "item": [
    {
      "name": "00 · 준비",
      "item": [
        {
          "name": "본인인증 공개 설정 — 허용된 키만 내려온다",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/identity/config",
              "host": [
                "{{baseUrl}}/api/identity/config"
              ]
            },
            "description": "브라우저가 인증 시작 전에 받아가는 설정. 여기에 복호화 키가 섞이면 자체점검 5번이 무너진다.\n동시에 이 응답의 provider 값으로 뒤 폴더들의 분기가 정해진다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "",
                  "const cfg = pm.response.json();",
                  "",
                  "// 프록시·CDN 이 설정을 캐시하면 채널 키 교체가 즉시 반영되지 않는다.",
                  "pm.test('Cache-Control: no-store', function () {",
                  "  pm.expect((pm.response.headers.get('cache-control') || '')).to.include('no-store');",
                  "});",
                  "",
                  "// 허용 목록 방식 — 새 키가 늘면 그 자체로 실패해야 한다(블랙리스트는 새 키를 놓친다).",
                  "pm.test('[5번] 허용된 키(provider/storeId/channelKey) 외에는 없다', function () {",
                  "  const allowed = ['provider', 'storeId', 'channelKey'];",
                  "  const extra = Object.keys(cfg).filter(function (k) { return allowed.indexOf(k) === -1; });",
                  "  pm.expect(extra, '예상 밖의 키: ' + extra.join(', ')).to.have.lengthOf(0);",
                  "});",
                  "",
                  "pm.test('[5번] 비밀값처럼 보이는 키가 없다', function () {",
                  "  const bad = Object.keys(cfg).filter(function (k) { return /secret|password|private|token|cert/i.test(k); });",
                  "  pm.expect(bad, '비밀값 의심 키: ' + bad.join(', ')).to.have.lengthOf(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('provider', cfg.provider);",
                  "",
                  "// 운영에서 mock 은 곧 무인증 가입이다. 환경파일이 기대 provider 를 못박는다.",
                  "const expected = pm.environment.get('expectProvider');",
                  "if (expected) {",
                  "  pm.test('[6번] provider 가 기대값(' + expected + ')과 같다 — mock 폴백은 무인증 가입을 의미한다', function () {",
                  "    pm.expect(cfg.provider).to.eql(expected);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · 중요정보 평문 노출 (1번)",
      "item": [
        {
          "name": "본인인증 응답에 CI/DI 가 실리지 않는다",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/identity/verify",
              "host": [
                "{{baseUrl}}/api/identity/verify"
              ]
            },
            "description": "mock 형식(이름+번호) 입력을 보낸다.\n· provider=mock(로컬): 인증이 성립하고, 응답에 CI/DI 가 없어야 한다. 발급된 토큰은 뒤 폴더가 재사용한다.\n· provider=portone(운영): 이 입력은 반드시 거부돼야 한다 — 통하면 운영에 mock 이 살아 있다는 뜻이다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{qaName}}\",\n  \"phone\": \"{{qaPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 9001 대역 = 이 레포의 일회성 픽스처 대역. E2E pretest-guard 의 스윕이",
                  "// 같은 대역을 회수하므로, 여기서 만든 잔재도 다음 E2E 실행에서 정리된다.",
                  "const rnd = function (n) {",
                  "  let out = '';",
                  "  for (let i = 0; i < n; i++) out += Math.floor(Math.random() * 10);",
                  "  return out;",
                  "};",
                  "pm.collectionVariables.set('qaPhone', '0109001' + rnd(3));",
                  "pm.collectionVariables.set('qaName', '점검용이름');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
