    {
      "name": "05 · 암호키·모듈 노출 (5번)",
      "item": [
        {
          "name": "클라이언트 번들에 서버 비밀이 실리지 않는다",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tech/signup",
              "host": [
                "{{baseUrl}}/tech/signup"
              ]
            },
            "description": "가입 화면이 로드하는 JS 번들을 전부 내려받아 비밀값을 훑는다.\n환경변수 secretsToScan 에 실제 PORTONE_API_SECRET 을 넣으면 실값 대조까지 된다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const html = pm.response.text();",
                  "const base = pm.environment.get('baseUrl');",
                  "",
                  "// 페이지가 로드하는 자체 호스팅 스크립트만 대상으로 한다(외부 CDN 은 우리 비밀을 못 받는다).",
                  "const srcs = [];",
                  "const re = /<script[^>]+src=\"([^\"]+)\"/g;",
                  "let m;",
                  "while ((m = re.exec(html)) !== null) {",
                  "  if (m[1].indexOf('/_next/') === 0) srcs.push(m[1]);",
                  "}",
                  "const targets = srcs.slice(0, Number(pm.environment.get('bundleScanLimit') || 20));",
                  "",
                  "pm.test('[5번] 검사할 스크립트 번들을 찾았다', function () {",
                  "  pm.expect(targets.length, '가입 화면에서 _next 스크립트를 하나도 못 찾았다').to.be.above(0);",
                  "});",
                  "",
                  "const needles = ['PORTONE_API_SECRET', 'IDENTITY_HASH_SECRET', 'AUTH_SECRET', 'DATABASE_URL', 'R2_SECRET_ACCESS_KEY']",
                  "  .concat((pm.environment.get('secretsToScan') || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean));",
                  "",
                  "const hits = [];",
                  "let done = 0;",
                  "const finish = function () {",
                  "  pm.test('[5번] 번들 ' + targets.length + '개에 서버 비밀이 없다', function () {",
                  "    pm.expect(hits, hits.join(' | ')).to.have.lengthOf(0);",
                  "  });",
                  "};",
                  "if (!targets.length) { finish(); }",
                  "targets.forEach(function (src) {",
                  "  pm.sendRequest({ url: base + src, method: 'GET' }, function (err, res) {",
                  "    if (!err && res) {",
                  "      const text = res.text() || '';",
                  "      needles.forEach(function (n) {",
                  "        if (text.indexOf(n) !== -1) hits.push(src + ' ← ' + n);",
                  "      });",
                  "    }",
                  "    if (++done === targets.length) finish();",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
