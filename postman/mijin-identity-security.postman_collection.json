    {
      "name": "06 · 접근통제 (6번)",
      "item": [
        {
          "name": "가드 라우트 64개 — 무세션은 전부 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/requests",
              "host": [
                "{{baseUrl}}/api/admin/requests"
              ]
            },
            "description": "라우트 매트릭스(tests/helpers/routes.ts)에 등재된 가드 대상 64개를 한 요청 안에서 전부 훑는다.\n요청을 64개로 쪼개지 않는 이유는 컬렉션을 작게 유지하기 위함이고, 실패 시에는\n어떤 (메서드 경로)가 뚫렸는지 단언 메시지에 그대로 나온다.\n\n경로 파라미터에는 존재하지 않는 id 를 넣는다 — 세션 가드가 조회보다 먼저라 401 판정에 영향이 없고,\nDB 도 건드리지 않는다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[6번] 대표 라우트(GET /api/admin/requests) 무세션 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "const routes = JSON.parse(pm.collectionVariables.get('guardedRoutes'));",
                  "const base = pm.environment.get('baseUrl');",
                  "const missing = 'pm-missing-' + pm.collectionVariables.get('runNonce');",
                  "const fill = function (p) {",
                  "  return p.replace('[id]', missing)",
                  "          .replace('[photoId]', missing)",
                  "          .replace('[token]', missing)",
                  "          .replace('[subject]', 'technician');",
                  "};",
                  "",
                  "const failures = [];",
                  "let i = 0;",
                  "",
                  "const finish = function () {",
                  "  pm.test('[6번] 가드 라우트 ' + routes.length + '개가 모두 무세션 401 이다', function () {",
                  "    pm.expect(failures, failures.join(' | ')).to.have.lengthOf(0);",
                  "  });",
                  "};",
                  "",
                  "const next = function () {",
                  "  if (i >= routes.length) return finish();",
                  "  const r = routes[i++];",
                  "  const opts = {",
                  "    url: base + fill(r.path),",
                  "    method: r.method,",
                  "    header: { 'Content-Type': 'application/json' },",
                  "  };",
                  "  // 변경 메서드에는 빈 JSON 을 준다. 가드를 통과하더라도 zod 400/404 로 떨어져 어떤 행도 쓰지 않는다.",
                  "  if (r.method !== 'GET') opts.body = { mode: 'raw', raw: '{}' };",
                  "  pm.sendRequest(opts, function (err, res) {",
                  "    if (err) failures.push(r.method + ' ' + r.path + ' → 요청 실패(' + err + ')');",
                  "    else if (res.code !== 401) failures.push(r.method + ' ' + r.path + ' → ' + res.code);",
                  "    next();",
                  "  });",
                  "};",
                  "next();"
                ]
              }
            }
          ]
        },
