            "description": "운영 전용. httpBaseUrl 이 비어 있으면 건너뛴다.\n\nTLS 프로토콜 버전 자체는 Postman 이 단언할 수 없다 — postman/tls-check.sh 가 담당한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 로컬 dev 서버는 HTTPS 를 제공하지 않으므로 이 판정은 운영에서만 의미가 있다.",
                  "const base = pm.environment.get('baseUrl') || '';",
                  "if (base.indexOf('https://') !== 0) {",
                  "  pm.test('[7번] 로컬 대상 — 평문 리다이렉트 판정 건너뜀 (운영 환경에서 실행할 것)', function () {",
                  "    pm.expect(true).to.be.true;",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "pm.test('[7번] 평문 HTTP 는 리다이렉트된다', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([301, 302, 307, 308]);",
