        {
          "name": "인증 1건은 가입 1건에만 쓰인다 (계정 생성 · 로컬 전용)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/identity/verify",
              "host": [
                "{{baseUrl}}/api/identity/verify"
              ]
            },
            "description": "자체점검 4번의 본체. 인증 → 가입 성공 → 같은 인증으로 재가입 시도 → 거부 를 실제로 태운다.\n\n⚠️ 전기기사 계정 1개를 실제로 만든다. 그래서 두 조건을 모두 만족할 때만 실행된다:\n  · 환경변수 allowAccountCreation=true\n  · provider=mock (운영은 portone 이라 자동으로 건너뛴다)\n생성 계정은 9001 대역이라 다음 E2E 실행의 pretest-guard 스윕이 회수한다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{qaName2}}\",\n  \"phone\": \"{{qaPhone2}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rnd = function (n) {",
                  "  let out = '';",
                  "  for (let i = 0; i < n; i++) out += Math.floor(Math.random() * 10);",
                  "  return out;",
                  "};",
                  "pm.collectionVariables.set('qaPhone2', '0109001' + rnd(3));",
                  "pm.collectionVariables.set('qaName2', '재사용점검');",
                  "pm.collectionVariables.set('qaLoginIdA', '9001-postman-' + rnd(8));",
                  "pm.collectionVariables.set('qaLoginIdB', '9001-postman-' + rnd(8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const provider = pm.collectionVariables.get('provider');",
                  "const allowed = pm.environment.get('allowAccountCreation') === 'true';",
                  "",
                  "if (provider !== 'mock' || !allowed) {",
                  "  pm.test('[4번] 계정 생성이 필요한 검사 — 건너뜀 (provider=' + provider + ', allowAccountCreation=' + allowed + ')', function () {",
                  "    pm.expect(true).to.be.true;",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "pm.test('인증 토큰 발급', function () { pm.response.to.have.status(200); });",
                  "const token = pm.response.json().verificationId;",
                  "",
                  "const base = pm.environment.get('baseUrl');",
                  "const ip = '203.0.113.' + (1 + Math.floor(Math.random() * 250));",
                  "const mkBody = function (loginId) {",
                  "  return {",
                  "    loginId: loginId,",
                  "    password: 'postman-check-1234',",
                  "    name: pm.collectionVariables.get('qaName2'),",
                  "    phone: pm.collectionVariables.get('qaPhone2'),",
                  "    address: '서울특별시 강남구 테헤란로 1',",
