{
  "id": "68aceb18-1dd1-40e9-8c9e-07eb21891cb2",
  "name": "mijin · 로컬 (mock)",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "default",
      "enabled": true,
      "description": "npm run dev 로 띄운 서버."
    },
    {
      "key": "httpBaseUrl",
      "value": "http://localhost:3000",
      "type": "default",
      "enabled": true,
      "description": "평문 HTTP→HTTPS 리다이렉트 검사 대상. 로컬은 HTTPS 자체가 없어 판정이 건너뛰어지며, 요청 URL 이 비면 러너가 에러를 내므로 값은 채워 둔다."
    },
    {
      "key": "expectProvider",
      "value": "mock",
      "type": "default",
      "enabled": true,
      "description": "이 환경에서 기대하는 본인인증 provider. 다르면 00 폴더가 실패한다."
    },
    {
      "key": "spoofClientIp",
      "value": "true",
      "type": "default",
      "enabled": true,
      "description": "요청마다 X-Forwarded-For 를 바꿔 인메모리 레이트리밋 버킷을 분리한다. 반복 실행 시 429 를 피하려는 것."
    },
    {
      "key": "allowAccountCreation",
      "value": "false",
      "type": "default",
      "enabled": true,
      "description": "true 로 바꾸면 04 폴더가 전기기사 계정 1개를 실제로 만들어 인증 단회성을 증명한다. 계정은 9001 대역이라 다음 E2E 실행의 pretest-guard 가 회수한다."
    },
    {
      "key": "secretsToScan",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "쉼표로 구분한 실제 비밀값(PORTONE_API_SECRET 등). 넣으면 모든 응답과 JS 번들에서 그 값을 찾는다. ⚠️ 이 환경 파일을 커밋하지 말 것."
    },
    {
      "key": "checkSecurityHeaders",
      "value": "true",
      "type": "default",
      "enabled": true,
      "description": "false 로 두면 전역 보안 헤더 검사를 끈다."
    },
    {
      "key": "checkCiLeak",
      "value": "true",
      "type": "default",
      "enabled": true,
      "description": "false 로 두면 전역 CI/DI 누출 검사를 끈다."
    },
    {
      "key": "bundleScanLimit",
      "value": "20",
      "type": "default",
      "enabled": true,
      "description": "05 폴더가 내려받아 훑을 JS 번들 최대 개수."
    },
    {
      "key": "minHstsMaxAge",
      "value": "31536000",
      "type": "default",
      "enabled": true,
      "description": "HSTS max-age 하한. 로컬은 앱이 내리는 값이 그대로 나가므로 1년을 그대로 요구한다."
    }
  ],
  "_postman_variable_scope": "environment",
  "_postman_exported_using": "mijin/postman"
