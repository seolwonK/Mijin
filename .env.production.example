# ============================================================
# 프로덕션(CloudType) 환경변수 예시
# 실제 값은 CloudType 프로젝트의 "환경변수"에 입력하세요. 이 파일은 커밋용 예시입니다.
# ============================================================

# [필수] PostgreSQL 연결 문자열
#   CloudType Postgres 템플릿 사용 시 내부 호스트명으로 연결 (예: postgresql://user:pass@postgres:5432/mijin?schema=public)
#   외부 매니지드 DB(Neon/Supabase 등)면 sslmode=require 를 붙이세요.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mijin?schema=public"

# [필수] JWT 세션 서명 키 — 32자 이상. 생성: openssl rand -hex 32
AUTH_SECRET="change-me-with-openssl-rand-hex-32"

# [선택] 만족도 조사 링크 등 SMS에 실리는 절대 URL의 기준. 미설정 시 요청 origin 폴백.
APP_BASE_URL="https://your-domain.example"

# [선택] 외부 cron 백업이 /api/internal/auto-assign 을 호출할 때 사용하는 시크릿
#   설정하지 않아도 인프로세스 워커(30초 주기)가 자동배정을 수행합니다.
CRON_SECRET=""

# [선택] 카카오 로컬 API 키 (주소↔좌표 지오코딩). 없으면 OSM Nominatim 무키 폴백 → 그래도 실패 시 수동 입력.
KAKAO_REST_API_KEY=""

# [선택] SMS 발송 방식: console(로그만) | solapi(실발송). 미설정 시 발송 생략.
SMS_PROVIDER="console"

# [선택] SMS_PROVIDER=solapi 일 때만 필요
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""

# [중요] 개인기술자 가입 휴대폰 본인인증(PortOne V2 + NHN KCP). 실서비스는 반드시 portone.
#   mock 은 입력값을 그대로 통과시키므로 프로덕션에서 쓰면 안 됩니다.
#   아래 셋은 모두 서버가 런타임에 읽습니다 — NEXT_PUBLIC_* 로 넣지 마세요.
#   NEXT_PUBLIC_ 값은 `next build` 시점에 번들로 인라인되는데 CloudType 은 환경변수를 컨테이너
#   런타임에만 주입해서, 빌드 산출물에 빈 값이 박혀 "본인인증 설정이 없습니다"로 죽습니다.
#   storeId·channelKey 는 브라우저가 /api/identity/config 로 받아 갑니다(src/lib/identity/config.ts).
IDENTITY_PROVIDER="portone"
# 포트원 콘솔 > 상점 정보. 채널 키와 함께 둘 다 필수입니다(하나라도 비면 기동 후 500).
PORTONE_STORE_ID=""
# 포트원 콘솔 > 결제 연동 > 채널 관리에서 발급. 속성=본인인증.
#   테스트 채널(공유 MID)은 인증창만 뜨고 실제 문자는 오지 않습니다 — 실문자는 실연동 채널부터.
#   실연동 채널은 KCP 계약 완료 후 PG상점아이디(사이트코드)·PG-API 인증서·본인인증 인증키로 생성.
PORTONE_CHANNEL_KEY=""
# 서버 재검증 전용(브라우저로 절대 내려가지 않음). 발급 시 1회만 표시되니 분실 주의.
PORTONE_API_SECRET=""
# [선택] CI/DI 저장용 해시 키. CI·DI 는 평문으로 보관하지 않고 이 키로 HMAC-SHA256 해시만
#   저장한다(src/lib/identity/hash.ts). 미설정 시 AUTH_SECRET 을 쓴다.
#   ⚠️ 한 번 정하면 바꾸지 말 것 — 키가 바뀌면 이전 해시와 대조가 끊겨 "같은 사람" 판정이 깨진다.
#   AUTH_SECRET 을 교체할 계획이 있다면 이 값을 별도로 고정해 두는 편이 안전하다.
IDENTITY_HASH_SECRET=""
# [탈출구] 프로덕션 빌드에서 IDENTITY_PROVIDER 가 portone 이 아니면 가입이 통째로 막힌다
#   (mock 은 입력값을 그대로 통과시켜 무인증 가입이 열리므로 fail-closed 로 둔다).
#   실서비스 배포본을 본인인증 없이 로컬 점검할 때만 1 로 켠다. 운영에는 절대 넣지 말 것.
# ALLOW_MOCK_IDENTITY="1"

# [선택] 서버 STT (음성 녹음 → 텍스트 자동 변환): gemini | openai.
#   미설정 시 변환만 생략되고 녹음 재생은 그대로 동작.
STT_PROVIDER="gemini"
# gemini 사용 시 (키 발급: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# GEMINI_STT_MODEL="gemini-2.5-flash"           # 기본값
# openai 사용 시
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"   # Groq 등 호환 서비스로 교체 가능
# OPENAI_STT_MODEL="whisper-1"

# [선택] 컨테이너 최초 기동 시 관리자/샘플 업체 계정 시드 (1이면 실행, upsert라 재실행 안전)
#   최초 배포 후에는 제거하거나 비워두세요.
RUN_DB_SEED="0"

# [권장] Cloudflare R2 — 고객이 접수 시 첨부한 고장 현장 사진 저장소.
#   넷 중 하나라도 비면 사진은 DB(StoredFile)에 저장된다 — 동작은 하지만 이미지가 DB 를
#   불리므로 실서비스에서는 R2 를 채우는 것을 권한다.
#   버킷은 **비공개**로 둘 것. 사진 본문은 앱의 권한 검사 라우트로만 나가고
#   (관리자 + 해당 건에 배정된 업체/기술자), 공개 URL 이나 커스텀 도메인을 붙이지 않는다.
#   키 발급: Cloudflare 대시보드 → R2 → "API 토큰 관리" → 오브젝트 읽기·쓰기 권한
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# R2_ENDPOINT=""   # 기본값 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# [선택] 업로드 저장 루트. 기본 /app/uploads. 스토리지를 다른 경로(예: /data)에
#   마운트했다면 그 경로로 지정. 기동 로그의 "업로드 디렉터리 쓰기 가능" 여부로 확인.
# UPLOADS_DIR="/app/uploads"
